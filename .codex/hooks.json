{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /Users/mima0000/CLionProjects/robot/tools/robot_guard.py hook --mode codex-session",
            "timeout": 10,
            "statusMessage": "检查 robot 对话的上下文压缩次数"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Edit|Write|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B /Users/mima0000/CLionProjects/robot/tools/robot_guard.py hook --mode codex-post",
            "timeout": 10,
            "statusMessage": "核对 robot 缺陷链阈值"
          }
        ]
      }
    ]
  }
}
