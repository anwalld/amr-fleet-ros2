# --- ROS2 / colcon 构建产物 ---
build/
install/
log/

# --- 编译中间产物 ---
*.o
*.obj
*.a
*.so
*.dylib
*.exe
compile_commands.json
CMakeUserPresets.json

# 例外：3D 模型资产（Wavefront OBJ），不是编译产物，必须纳入版本库
!src/robot_simulation/media/text_meshes/*.obj

# --- 环境与缓存 ---
.env
.env.*
.cache/
*.log

# --- Python 缓存 ---
__pycache__/
*.pyc
*.pyo

# --- 编辑器 / 本地工具配置 ---
.vscode/*.log
.claude/

# --- 本地 AI 助手配置（保留在本地，不纳入版本库）---
CLAUDE.md
.vscode/

# --- IDE ---
.idea/

# --- 参照常见 ROS2 / CMake / Qt / JetBrains 仓库补充 ---
# CLion 默认构建目录与 CMake 中间产物（在包内直接 cmake 时）
cmake-build-*/
CMakeCache.txt
CMakeFiles/
# Qt Creator 本地工程配置（M4 调度台）
CMakeLists.txt.user*
*.pro.user*
# Python 测试与打包缓存
.pytest_cache/
*.egg-info/
.coverage
# ROS 录包（体积大，按需另存）
*.bag
*.mcap
*.db3
# 系统与编辑器临时文件
.DS_Store
*.swp
*~
core.[0-9]*
